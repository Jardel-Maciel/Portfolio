# Copie para ".env.local" para desenvolvimento, ou configure como variável
# de ambiente na Vercel/Render ao publicar o site.
#
# URL do backend de administração (pasta server/). Sem essa variável, a
# seção de projetos usa a lista estática de src/data/projects.ts e a rota
# /admin fica sem funcionar — o resto do site continua normal.
VITE_API_URL=http://localhost:5050
