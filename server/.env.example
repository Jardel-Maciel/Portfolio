# Copie este arquivo para ".env" e preencha os valores antes de rodar localmente.
# Em produção (Render), essas mesmas chaves são configuradas em Environment Variables.

# String de conexão do Postgres (Neon, Render Postgres, ou local)
DATABASE_URL=postgresql://usuario:senha@host:5432/portfolio

# Senha usada para logar em /admin. Escolha algo forte e único.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o token de sessão do admin. Gere um valor
# aleatório, por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-este-segredo

# Origem(ns) do site público que podem chamar essa API, separadas por vírgula.
# Em desenvolvimento local, o Vite roda em http://localhost:5173.
ALLOWED_ORIGIN=http://localhost:5173

# Credenciais do Cloudinary (cloudinary.com — plano gratuito), usadas para
# guardar as imagens/prints dos projetos. Pegue os três valores no painel
# principal do Cloudinary, em "Cloud name", "API Key" e "API Secret".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
